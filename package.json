{
    "name": "gmacs-syntax",
    "displayName": "GMACS/ACOMPUTE Compute Shader Syntax",
    "description": "Syntax highlighting for Acerola/Godot MA Compute Shaders (.acompute, .gmacs)",
    "version": "1.0.2",
    "author": "Matej Zeman",
    "publisher": "matej-zeman",
    "license": "MIT",
    "icon": "extension-logo.png",
    "repository": {
        "type": "git",
        "url": "https://github.com/MatejZeman02/gmacs-acompute-syntax-highlighting-vs-code-extension.git"
    },
    "engines": {
        "vscode": "^1.80.0"
    },
    "categories": [
        "Programming Languages"
    ],
    "extensionDependencies": [
        "geequlim.godot-tools"
    ],
    "contributes": {
        "languages": [
            {
                "id": "gmacs",
                "aliases": [
                    "GMACS",
                    "ACOMPUTE"
                ],
                "extensions": [
                    ".gmacs",
                    ".acompute",
                    ".glsl",
                    ".c"
                ],
                "icon": {
                    "light": "./file-icon-light.png",
                    "dark": "./file-icon-dark.png"
                },
                "configuration": "./language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "gmacs",
                "scopeName": "source.gmacs",
                "path": "./syntaxes/gmacs.tmLanguage.json"
            }
        ]
    }
}