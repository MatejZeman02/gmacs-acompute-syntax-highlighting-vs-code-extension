{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "GMACS compute shader dialect",
    "scopeName": "source.gmacs",
    "patterns": [
        {
            "include": "#directive-include"
        },
        {
            "include": "#directive-kernel"
        },
        {
            "include": "#numthreads"
        },
        {
            "include": "#preprocessor-macro"
        },
        {
            "include": "#preprocessor"
        },
        {
            "include": "#comment"
        },
        {
            "include": "#decorator"
        },
        {
            "include": "#kernel"
        },
        {
            "include": "#import"
        },
        {
            "include": "#def"
        },
        {
            "include": "#struct"
        },
        {
            "include": "#params"
        },
        {
            "include": "#image"
        },
        {
            "include": "#sampler"
        },
        {
            "include": "#buffer"
        },
        {
            "include": "#for-range"
        },
        {
            "include": "#case-wildcard"
        },
        {
            "include": "#match"
        },
        {
            "include": "#keyword-control"
        },
        {
            "include": "#block-colon"
        },
        {
            "include": "#hint"
        },
        {
            "include": "#expression"
        },
        {
            "include": "source.gdshader"
        }
    ],
    "repository": {
        "comment": {
            "name": "comment.line.number-sign.gmacs",
            "match": "(#).*$",
            "captures": {
                "1": {
                    "name": "punctuation.definition.comment.gmacs"
                }
            }
        },
        "directive-include": {
            "match": "^\\s*(#include)\\s+(\\\"[^\\\"]+\\\"|<[^>]+>)",
            "captures": {
                "1": {
                    "name": "keyword.control.directive.include.gmacs"
                },
                "2": {
                    "name": "string.quoted.double.include.gmacs"
                }
            }
        },
        "directive-kernel": {
            "match": "^\\s*(#kernel)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
            "captures": {
                "1": {
                    "name": "keyword.control.directive.kernel.gmacs"
                },
                "2": {
                    "name": "entity.name.function.gmacs"
                }
            }
        },
        "numthreads": {
            "begin": "\\[\\s*(numthreads)\\b",
            "beginCaptures": {
                "1": {
                    "name": "keyword.other.numthreads.gmacs"
                }
            },
            "end": "\\]",
            "patterns": [
                {
                    "match": "\\b[0-9]+\\b",
                    "name": "constant.numeric.integer.gmacs"
                }
            ]
        },
        "preprocessor-macro": {
            "match": "^\\s*(#(?:define|undef|ifdef|ifndef))\\s+([A-Za-z_]\\w*)",
            "captures": {
                "1": {
                    "name": "keyword.control.directive.gmacs"
                },
                "2": {
                    "name": "entity.name.function.preprocessor.gmacs"
                }
            }
        },
        "preprocessor": {
            "match": "^\\s*(#(?:version|pragma|extension|if|elif|else|endif|line|error))\\b",
            "captures": {
                "1": {
                    "name": "keyword.control.directive.gmacs"
                }
            }
        },
        "type-builtin": {
            "name": "support.type.gmacs",
            "match": "\\b(?:void|bool|u?int|float|double|[biud]?vec[234]|d?mat[234](?:x[234])?|[iu]?(?:sampler|image)(?:1D|2D|3D|Cube|Buffer|1DArray|2DArray|2DMS|2DRect|CubeArray)|atomic_uint)\\b"
        },
        "type-user": {
            "name": "entity.name.type.gmacs",
            "match": "\\b[A-Za-z_]\\w*\\b(?=\\s+[A-Za-z_]\\w*)"
        },
        "storage-modifier": {
            "name": "storage.modifier.gmacs",
            "match": "\\b(?:const|in|out|inout|uniform|shared|readonly|writeonly|coherent|volatile|restrict|highp|mediump|lowp|flat|smooth)\\b"
        },
        "number": {
            "name": "constant.numeric.gmacs",
            "match": "\\b(?:0[xX][0-9A-Fa-f]+|\\d+)[uU]?\\b"
        },
        "kernel": {
            "match": "^\\s*(kernel)\\s+([A-Za-z_]\\w*)\\b",
            "captures": {
                "1": {
                    "name": "keyword.control.directive.kernel.gmacs"
                },
                "2": {
                    "name": "entity.name.function.gmacs"
                }
            }
        },
        "import": {
            "match": "^\\s*(import)\\s+([A-Za-z_][\\w/]*)",
            "captures": {
                "1": {
                    "name": "keyword.control.import.gmacs"
                },
                "2": {
                    "name": "entity.name.namespace.gmacs"
                }
            }
        },
        "image": {
            "match": "^\\s*(image)\\s+([A-Za-z_]\\w*)(?:\\s*(:)([^#\\n]*))?",
            "captures": {
                "1": {
                    "name": "storage.type.image.gmacs"
                },
                "2": {
                    "name": "variable.other.binding.gmacs"
                },
                "3": {
                    "name": "punctuation.separator.colon.gmacs"
                },
                "4": {
                    "patterns": [
                        {
                            "name": "constant.language.image-format.gmacs",
                            "match": "\\b(?:rgba32f|rgba16f|r32f|r16f)\\b"
                        },
                        {
                            "name": "storage.modifier.gmacs",
                            "match": "\\b(?:readonly|writeonly|coherent|volatile|restrict)\\b"
                        }
                    ]
                }
            }
        },
        "sampler": {
            "match": "^\\s*(sampler)\\s+([A-Za-z_]\\w*)\\b",
            "captures": {
                "1": {
                    "name": "storage.type.sampler.gmacs"
                },
                "2": {
                    "name": "variable.other.binding.gmacs"
                }
            }
        },
        "buffer": {
            "match": "^\\s*(buffer)\\s+([A-Za-z_]\\w*)\\s*(:)([^#\\n]*)",
            "captures": {
                "1": {
                    "name": "storage.type.buffer.gmacs"
                },
                "2": {
                    "name": "variable.other.binding.gmacs"
                },
                "3": {
                    "name": "punctuation.separator.colon.gmacs"
                },
                "4": {
                    "patterns": [
                        {
                            "include": "#comment"
                        },
                        {
                            "include": "#storage-modifier"
                        },
                        {
                            "include": "#type-builtin"
                        },
                        {
                            "include": "#type-user"
                        },
                        {
                            "include": "#number"
                        },
                        {
                            "name": "variable.other.member.gmacs",
                            "match": "\\b[A-Za-z_]\\w*\\b"
                        }
                    ]
                }
            }
        },
        "params": {
            "name": "meta.params.gmacs",
            "begin": "^([ \\t]*)(params)(?:\\s+([A-Za-z_]\\w*))?\\s*(:)",
            "beginCaptures": {
                "2": {
                    "name": "storage.type.params.gmacs"
                },
                "3": {
                    "name": "variable.other.binding.gmacs"
                },
                "4": {
                    "name": "punctuation.section.block.begin.gmacs"
                }
            },
            "end": "^(?!\\1[ \\t]+\\S|[ \\t]*$|[ \\t]*#)",
            "patterns": [
                {
                    "include": "#comment"
                },
                {
                    "include": "#storage-modifier"
                },
                {
                    "include": "#type-builtin"
                },
                {
                    "include": "#type-user"
                },
                {
                    "include": "#number"
                },
                {
                    "name": "variable.other.member.gmacs",
                    "match": "\\b[A-Za-z_]\\w*\\b"
                }
            ]
        },
        "struct": {
            "name": "meta.struct.gmacs",
            "begin": "^([ \\t]*)(struct)\\s+([A-Za-z_]\\w*)\\s*(:)",
            "beginCaptures": {
                "2": {
                    "name": "storage.type.struct.gmacs"
                },
                "3": {
                    "name": "entity.name.type.struct.gmacs"
                },
                "4": {
                    "name": "punctuation.section.block.begin.gmacs"
                }
            },
            "end": "^(?!\\1[ \\t]+\\S|[ \\t]*$|[ \\t]*#)",
            "patterns": [
                {
                    "include": "#comment"
                },
                {
                    "include": "#storage-modifier"
                },
                {
                    "include": "#type-builtin"
                },
                {
                    "include": "#type-user"
                },
                {
                    "include": "#number"
                },
                {
                    "name": "variable.other.member.gmacs",
                    "match": "\\b[A-Za-z_]\\w*\\b"
                }
            ]
        },
        "def": {
            "name": "meta.function.gmacs",
            "begin": "^\\s*(def)\\s+([A-Za-z_]\\w*)\\s*(\\()",
            "beginCaptures": {
                "1": {
                    "name": "storage.type.function.gmacs"
                },
                "2": {
                    "name": "entity.name.function.gmacs"
                },
                "3": {
                    "name": "punctuation.section.parameters.begin.gmacs"
                }
            },
            "end": "(\\))(?:\\s*(->)\\s*([A-Za-z_]\\w*))?|(?=^(?:def|kernel|import|struct|params)\\b)",
            "endCaptures": {
                "1": {
                    "name": "punctuation.section.parameters.end.gmacs"
                },
                "2": {
                    "name": "punctuation.separator.annotation.result.gmacs"
                },
                "3": {
                    "patterns": [
                        {
                            "include": "#type-builtin"
                        },
                        {
                            "name": "entity.name.type.gmacs",
                            "match": "\\w+"
                        }
                    ]
                }
            },
            "patterns": [
                {
                    "include": "#comment"
                },
                {
                    "include": "#storage-modifier"
                },
                {
                    "include": "#type-builtin"
                },
                {
                    "include": "#type-user"
                },
                {
                    "include": "#number"
                },
                {
                    "name": "variable.parameter.gmacs",
                    "match": "\\b[A-Za-z_]\\w*\\b"
                }
            ]
        },
        "for-range": {
            "match": "^\\s*(for)\\s+(?:([A-Za-z_]\\w*)\\s+)?([A-Za-z_]\\w*)\\s+(in)\\s+(range_inclusive|range)\\b",
            "captures": {
                "1": {
                    "name": "keyword.control.gmacs"
                },
                "2": {
                    "patterns": [
                        {
                            "include": "#type-builtin"
                        },
                        {
                            "name": "entity.name.type.gmacs",
                            "match": "\\w+"
                        }
                    ]
                },
                "3": {
                    "name": "variable.other.gmacs"
                },
                "4": {
                    "name": "keyword.control.gmacs"
                },
                "5": {
                    "name": "support.function.builtin.gmacs"
                }
            }
        },
        "case-wildcard": {
            "match": "^\\s*(case)\\s+(_)\\s*(:)",
            "captures": {
                "1": {
                    "name": "keyword.control.gmacs"
                },
                "2": {
                    "name": "constant.language.wildcard.gmacs"
                },
                "3": {
                    "name": "punctuation.section.block.begin.gmacs"
                }
            }
        },
        "match": {
            "match": "^\\s*(match)\\s+(?=[^=\\s])",
            "captures": {
                "1": {
                    "name": "keyword.control.gmacs"
                }
            }
        },
        "keyword-control": {
            "name": "keyword.control.gmacs",
            "match": "\\b(?:if|elif|else|while|for|do|switch|case|default|return|break|continue|discard)\\b"
        },
        "block-colon": {
            "name": "punctuation.section.block.begin.gmacs",
            "match": ":(?=\\s*(?:#.*)?$)"
        },
        "decorator": {
            "name": "entity.name.function.decorator.gmacs",
            "match": "@[A-Za-z_]\\w*"
        },
        "word-operator": {
            "name": "keyword.control.gmacs",
            "match": "\\b(?:and|or|not)\\b"
        },
        "operand": {
            "name": "variable.other.gmacs",
            "match": "\\b(?!(?:true|false)\\b)[A-Za-z_]\\w*\\b(?=\\s+(?:and|or)\\b)"
        },
        "builtin-variable": {
            "name": "variable.language.gmacs",
            "match": "(?<![.\\w])(?:pixel|gl_LocalInvocationIndex|gl_GlobalInvocationID|gl_LocalInvocationID|gl_NumWorkGroups|gl_WorkGroupSize|gl_WorkGroupID|group_count|local_index|group_size|global_id|group_id|local_id|gl_\\w+)\\b"
        },
        "builtin-function": {
            "name": "support.function.builtin.gmacs",
            "match": "\\b(?:memory_barrier_atomic_counter|memoryBarrierAtomicCounter|atomic_counter_decrement|atomic_counter_increment|atomicCounterDecrement|atomicCounterIncrement|image_atomic_comp_swap|texture_gather_offsets|image_atomic_exchange|memory_barrier_buffer|memory_barrier_shared|texture_gather_offset|group_memory_barrier|memory_barrier_image|textureGatherOffsets|texture_query_levels|imageAtomicCompSwap|imageAtomicExchange|memoryBarrierBuffer|memoryBarrierShared|textureGatherOffset|texture_grad_offset|texture_proj_offset|float_bits_to_uint|greater_than_equal|groupMemoryBarrier|memoryBarrierImage|texel_fetch_offset|textureQueryLevels|texture_lod_offset|uint_bits_to_float|float_bits_to_int|int_bits_to_float|textureGradOffset|textureProjOffset|texture_proj_grad|texture_query_lod|unpack_double2x32|atomic_comp_swap|bitfield_extract|bitfield_reverse|greaterThanEqual|image_atomic_add|image_atomic_and|image_atomic_max|image_atomic_min|image_atomic_xor|matrix_comp_mult|texelFetchOffset|textureLodOffset|texture_proj_lod|unpackDouble2x32|unpack_snorm2x16|unpack_unorm2x16|atomic_exchange|bitfieldExtract|bitfieldReverse|bitfield_insert|control_barrier|floatBitsToUint|image_atomic_or|less_than_equal|pack_double2x32|textureProjGrad|textureQueryLod|texture_samples|uintBitsToFloat|unpackSnorm2x16|unpackUnorm2x16|unpack_half2x16|unpack_snorm4x8|unpack_unorm4x8|atomicCompSwap|atomicExchange|atomic_counter|bitfieldInsert|controlBarrier|floatBitsToInt|imageAtomicAdd|imageAtomicAnd|imageAtomicMax|imageAtomicMin|imageAtomicXor|intBitsToFloat|matrixCompMult|memory_barrier|packDouble2x32|pack_snorm2x16|pack_unorm2x16|textureProjLod|textureSamples|texture_gather|texture_offset|unpackHalf2x16|unpackSnorm4x8|unpackUnorm4x8|atomicCounter|imageAtomicOr|image_samples|imul_extended|lessThanEqual|memoryBarrier|outer_product|packSnorm2x16|packUnorm2x16|pack_half2x16|pack_snorm4x8|pack_unorm4x8|textureGather|textureOffset|umul_extended|greater_than|imageSamples|imulExtended|outerProduct|packHalf2x16|packSnorm4x8|packUnorm4x8|texture_grad|texture_proj|texture_size|umulExtended|greaterThan|image_store|texel_fetch|textureGrad|textureProj|textureSize|texture_lod|usub_borrow|atomic_add|atomic_and|atomic_max|atomic_min|atomic_xor|imageStore|image_load|image_size|round_even|texelFetch|textureLod|uadd_carry|usubBorrow|atomicAdd|atomicAnd|atomicMax|atomicMin|atomicXor|atomic_or|bit_count|imageLoad|imageSize|less_than|not_equal|roundEven|uaddCarry|atomicOr|bitCount|find_lsb|find_msb|lessThan|notEqual|barrier|findLSB|findMSB|range_inclusive|range)\\b(?=\\s*\\()"
        },
        "storage-modifier-glsl": {
            "name": "storage.modifier.gmacs",
            "match": "\\b(?:shared|layout|buffer|push_constant|std430|std140|readonly|writeonly|coherent|volatile|restrict)\\b"
        },
        "parens": {
            "name": "meta.parenthesis.gmacs",
            "begin": "\\(",
            "beginCaptures": {
                "0": {
                    "name": "punctuation.parenthesis.begin.gmacs"
                }
            },
            "end": "\\)",
            "endCaptures": {
                "0": {
                    "name": "punctuation.parenthesis.end.gmacs"
                }
            },
            "patterns": [
                {
                    "include": "#comment"
                },
                {
                    "include": "#expression"
                },
                {
                    "include": "source.gdshader"
                }
            ]
        },
        "expression": {
            "patterns": [
                {
                    "include": "#parens"
                },
                {
                    "include": "#word-operator"
                },
                {
                    "include": "#operand"
                },
                {
                    "include": "#builtin-variable"
                },
                {
                    "include": "#builtin-function"
                },
                {
                    "include": "#storage-modifier-glsl"
                },
                {
                    "include": "#type-builtin"
                }
            ]
        },
        "hint": {
            "name": "support.type.annotation.gmacs",
            "match": "\\b(?:hint_range|hint_enum|source_color)\\b"
        }
    }
}
